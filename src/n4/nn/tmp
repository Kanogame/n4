from abc import ABC, abstractmethod
from typing import Optional, List, Any

from n4.core.numeric import NumericProtocol
from n4.core import Value, Op
from n4.op import NonOp
from .nn_base import NnBase


# ----------------------------------------------------------------------
# Modified Neuron class
# ----------------------------------------------------------------------
class Neuron[T: NumericProtocol](NnBase):
    """A single neuron with trainable weights and bias.

    Args:
        w_len: Number of input connections (must be >= 1).
        activation: Activation function to apply after the linear combination.
                   If None, a linear neuron (NonOp) is used.
        backend: The numeric backend class (e.g., PyFloat) that provides
                 static methods like random_uniform and zero.

    Attributes:
        w: List of weight Value[T] objects.
        b: Bias Value[T].
        activation: The activation operation class.
        _backend: The numeric backend class.
    """

    w: list[Value[T]]
    b: Value[T]
    activation: type[Op[T]]
    _backend: type[T]

    def __init__(
        self,
        w_len: int,
        activation: Optional[type[Op[T]]] = None,
        backend: type[T] = None,
    ) -> None:
        if backend is None:
            raise ValueError("A numeric backend must be provided.")
        if w_len < 1:
            raise ValueError("w_len must be >= 1")

        self._backend = backend
        self.w = [self._backend.random_uniform(-1, 1) for _ in range(w_len)]
        self.b = self._backend.zero()
        self.activation = NonOp if activation is None else activation

    def __call__(self, x: List[Value[T]]) -> Value[T]:
        """Compute the neuron output for a given input vector.

        Args:
            x: Input vector of length `w_len`.

        Returns:
            The activated output value.
        """
        act: Value[T] = self.b
        for i in range(len(self.w)):
            act += self.w[i] * x[i]
        return act.apply_activation(self.activation)

    def parameters(self) -> List[Value[T]]:
        """Return all trainable parameters (weights + bias)."""
        return self.w + [self.b]

    def __repr__(self) -> str:
        return f"{self.activation} Neuron({len(self.w)})"


